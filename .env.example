# AppTask board (audit: /audit_full, /audit_limit)
APPTASK_BOARD_URL=https://apptask.ru/c/7/board/445
APPTASK_PROJECT_NAME=AppTask Project

# Comments board (Discord: /comments_full, /comments_limit — default when board_url omitted)
APPTASK_COMMENTS_BOARD_URL=https://apptask.ru/c/7/board/54
# Optional API host (usually auto-detected when board opens in browser)
# APPTASK_API_BASE=https://host2201.apptask.ru

# Users page diagnostic (npm run debug:users) — copy from AppTask menu «Пользователи»
# APPTASK_USERS_URL=https://apptask.ru/c/7/settings/users

# Payroll report diagnostic (npm run probe:payroll:fired) — «Отчёты → Зарплатный»
# APPTASK_PAYROLL_REPORT_URL=https://apptask.ru/c/7/reports/payment

# Tracking / screenshots activities (npm run probe:tracking:comments)
# APPTASK_ACTIVITIES_URL=https://apptask.ru/c/7/activities/2026-05-20/684/0

# Persistent Chromium profile (default: playwright/.user-data/apptask)
# APPTASK_USER_DATA_DIR=playwright/.user-data/apptask

# Discord (optional) — summary + audit.json attachment
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord bot bootstrap (npm run discord:bot)
# DISCORD_BOT_TOKEN=your-bot-token
# Optional: register /audit on one guild instantly (Developer Mode → copy server ID)
# DISCORD_GUILD_ID=123456789012345678
# Full audit reports (summary + files) → dedicated channel; slash reply stays ephemeral
# AUDIT_DISCORD_CHANNEL_ID=123456789012345678  # канал на нужном сервере (Атаев Маркет, не Volkrist)

# Daily scheduled audit at 09:00 (Task Scheduler: infra\windows\setup-task-scheduler.ps1)
# Full card audit per enabled project + full comments on APPTASK_COMMENTS_BOARD_URL
# npm run audit:scheduled — logs: logs\scheduled.log
# Discord bot: /project_add, /project_list, /project_remove — see docs/DISCORD_PROJECTS.md

# Limit cards per audit run (0 = all cards on board)
# APPTASK_AUDIT_MAX_CARDS=30

# Task card open strategy: auto | url-first | click-first (default: auto)
# auto — long ids: direct URL then click; short ids (1–3 digits): click first
# CARD_OPEN_STRATEGY=auto

# Comma-separated required tags (empty = WARN "not configured")
# REQUIRED_TAGS=срочно,клиент

# QA testers on review stage (empty = only require any assignee)
# QA_TESTERS=Иван Иванов,Петр Петров

# HTTP link reachability in rules (default: true)
# LINK_CHECK_ENABLED=false

# Task card comments in audit (default: off) — API get_task_comments, no modal per task
# COMMENTS_AUDIT_MODE=off|candidates|all
# COMMENTS_AUDIT_CONCURRENCY=3
# COMMENTS_AUDIT_LIMIT=   # max tasks to load comments (Discord comments_limit overrides)
# Discord /audit: comments_board_url — отдельная доска для комментариев (иначе = board_url)
# APPTASK_COMMENTS_API_BASE=https://host2201.apptask.ru

# Local web UI (npm run web)
# PORT=3000
# HOST=127.0.0.1
