{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/adapters/apptask/**/*.ts",
    "src/rules/**/*.ts",
    "src/rules/helpers/**/*.ts",
    "src/config/**/*.ts",
    "src/reports/**/*.ts",
    "src/app/**/*.ts",
    "src/adapters/discord/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/web/**/*.ts",
    "src/discord/**/*.ts",
    "src/users/**/*.ts",
    "src/scripts/**/*.ts",
    "playwright.config.ts"
  ]
}
